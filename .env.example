# Server configuration; copy intentionally, never overwrite an existing .env.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional: both fields required to enable Groq fallback.
GROQ_API_KEY=
GROQ_MODEL=
# Optional: search also requires user opt-in.
TAVILY_API_KEY=
ANALYSIS_TIMEOUT_MS=45000
PROVIDER_TIMEOUT_MS=18000
MAX_ANALYSES_PER_USER_PER_HOUR=12
MAX_CONCURRENT_ANALYSES=3
ANALYSIS_SIGNING_SECRET=
# A random 32+ character server credential. Configure its SHA-256 digest in
# private.runtime_config as described in README.md. Never send it to the browser.
# No service-role secret is needed by normal runtime requests.
