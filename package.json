{
  "name": "third-eye",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json",
    "test": "tsx --test tests/*.test.ts",
    "test:live": "tsx scripts/live-smoke.ts",
    "test:e2e": "playwright test",
    "check:services": "tsx scripts/check-services.ts",
    "test:live:workflow": "tsx scripts/live-workflow.ts",
    "test:live:browser": "tsx scripts/live-browser.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
